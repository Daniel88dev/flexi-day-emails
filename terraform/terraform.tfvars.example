aws_region  = "eu-central-1"
environment = "production"

github_repository = "daniel88dev/flexi-day-emails"

# The GitHub OIDC provider is account-global and already exists (flexi-day-be
# uses it), so this stays false and the provider is looked up. Set to true
# only in an account that has never set up GitHub Actions OIDC.
create_github_oidc_provider = false
