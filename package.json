{
  "name": "flexi-day-emails",
  "version": "0.1.0",
  "private": true,
  "description": "Transactional email templates for flexiday, rendered with react-email and synced to AWS SES",
  "type": "module",
  "scripts": {
    "dev": "email dev --dir emails",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "build": "tsx src/render.ts && tsx src/verify.ts",
    "sync": "npm run build && tsx src/sync-templates.ts",
    "sync:dev": "STAGE=dev npm run sync",
    "sync:prod": "STAGE=prod npm run sync"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1098.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^1.1.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-email": "^6.9.1"
  },
  "devDependencies": {
    "@react-email/preview-server": "^5.2.11",
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tsx": "^4.19.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
