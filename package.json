{
  "name": "flexi-day-emails",
  "version": "0.1.0",
  "private": true,
  "description": "Transactional email templates for flexiday, rendered with react-email and synced to AWS SES",
  "type": "module",
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "scripts": {
    "dev": "email dev --dir emails",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "build": "tsx src/render.ts && tsx src/verify.ts",
    "sync": "pnpm run build && tsx src/sync-templates.ts",
    "sync:dev": "STAGE=dev pnpm run sync",
    "sync:prod": "STAGE=prod pnpm run sync",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1159.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-email": "^6.11.6"
  },
  "devDependencies": {
    "@react-email/preview-server": "^5.2.11",
    "@react-email/ui": "^6.11.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
